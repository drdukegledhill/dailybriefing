# Copy to .env and edit.

# --- AI editor (required) -------------------------------------------------------
# Create a key at https://platform.claude.com (Settings > API keys) and set a small
# monthly spend limit there. Claude Sonnet 5.5 costs about 5p a day.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5      # or claude-haiku-5-5 (~0.5p a day) / claude-opus-5-5 (~12p)
# CLAUDE_EFFORT=medium                # low | medium | high: how hard it thinks

# --- Output ---------------------------------------------------------------------
# Where each day's PDF is saved. Point this at a shared folder once it's mounted,
# e.g. /mnt/briefings
# OUTPUT_DIR=/home/pi/morning-brief/briefings

# PDF page limit (2 = one sheet, both sides). Lower-priority items are trimmed to fit.
# MAX_PAGES=2

# After time away, catch up on at most this much news (168 hours = a week).
# MAX_LOOKBACK_HOURS=168

# --- Printing (optional) --------------------------------------------------------
# PRINT=false
# PRINTER_URI=ipp://192.168.1.50:631/ipp/print   # your printer's address
# PRINT_DUPLEX=true
# PRINT_COLOUR=color                  # or monochrome (saves colour toner)

# --- Inky pHAT status screen (optional) --------------------------------------------
# Shows the issue, date, time and whether editing, the PDF and printing worked.
# ./pi/install.sh --inky sets this up and switches it on.
# INKY=false
# INKY_COLOUR=auto                    # auto (reads the pHAT's ID chip) | red | yellow | black
# INKY_ROTATE=0                       # 180 if the screen is upside down

# --- Masthead -------------------------------------------------------------------
# DIGEST_TITLE=The Morning Brief
# DIGEST_SUBTITLE=Engineering · Computing · Games in UK Higher Education
